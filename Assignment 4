# Matrix Addition using numpy
import numpy as np

rows = int(input("Enter number of rows: "))
cols = int(input("Enter number of columns: "))

print("Enter elements of Matrix A row-wise (space separated):")
A = np.array([list(map(int, input().split())) for _ in range(rows)])

print("Enter elements of Matrix B row-wise (space separated):")
B = np.array([list(map(int, input().split())) for _ in range(rows)])

C = A + B   # element-wise addition

print("\nMatrix A:\n", A)
print("\nMatrix B:\n", B)
print("\nSum of Matrix A and B:\n", C)
